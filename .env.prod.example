# One KEY=value per line, no comment after a value (the deployer reads it literally).
# __GENERER__ = created by the deployer, once. __FACULTATIF__ = may stay empty.
# An empty value (ADMIN_EMAILS) must be filled by Mehdi: production waits for it.
SECRET_KEY=__GENERER__
WEBHOOK_SECRET=__GENERER__
ADMIN_EMAILS=
APP_URL=https://__DOMAINE__
CANONICAL_HOST=__DOMAINE__
SMTP_HOST=__FACULTATIF__
SMTP_PORT=__FACULTATIF__
SMTP_USER=__FACULTATIF__
SMTP_PASSWORD=__FACULTATIF__
SMTP_FROM=__FACULTATIF__
REQUIRE_EMAIL_VERIFICATION=__FACULTATIF__
