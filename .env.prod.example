# Réglages de l'application en prod (usine à SaaS). Les noms seulement : les valeurs
# sont chez root, dans /etc/usine-prod/padel-trainer-tracker.reglages.
#   __GENERER__ = créé par le déployeur ; vide = à remplir par Mehdi ;
#   __FACULTATIF__ = peut rester vide ; __DOMAINE__ = le domaine de la prod.
SECRET_KEY=__GENERER__
WEBHOOK_SECRET=__GENERER__
ADMIN_EMAILS=
APP_URL=https://__DOMAINE__
CANONICAL_HOST=__DOMAINE__
SMTP_HOST=__FACULTATIF__
SMTP_PORT=587
SMTP_USER=__FACULTATIF__
SMTP_PASSWORD=__FACULTATIF__
SMTP_FROM=__FACULTATIF__
REQUIRE_EMAIL_VERIFICATION=__FACULTATIF__
NOTIFY_EMAIL_ONLY=1
TEST_ACCOUNT_EMAILS=__FACULTATIF__
