# Copier en .env puis remplir. Générer les secrets avec: openssl rand -hex 32
DOMAIN=padel.mondomaine.tn
SECRET_KEY=changez-moi
WEBHOOK_SECRET=changez-moi-aussi
# E-mails de rappel de séance (facultatif: sans SMTP_HOST, les e-mails sont seulement journalisés)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Adresse publique de l'application (liens des e-mails: vérification, promotions)
APP_URL=https://padel.mondomaine.tn
# Vérification de l'e-mail des joueurs: exigée dès que SMTP_HOST est réglé (1 = toujours, 0 = jamais)
REQUIRE_EMAIL_VERIFICATION=
