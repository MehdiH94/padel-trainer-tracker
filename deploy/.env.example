# Copier en .env puis remplir. Générer les secrets avec: openssl rand -hex 32
DOMAIN=padel.mondomaine.tn
SECRET_KEY=changez-moi
WEBHOOK_SECRET=changez-moi-aussi
# E-mails de rappel de séance (facultatif: sans SMTP_HOST, les e-mails sont seulement journalisés)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Domaine définitif: toute autre adresse (ancien domaine, IP) redirige vers https://CANONICAL_HOST (voir docs/DOMAINE.md)
CANONICAL_HOST=
# Adresse publique de l'application (liens des e-mails: vérification, promotions)
APP_URL=https://padel.mondomaine.tn
# Vérification de l'e-mail des joueurs: exigée dès que SMTP_HOST est réglé (1 = toujours, 0 = jamais)
REQUIRE_EMAIL_VERIFICATION=
# Administrateurs (e-mails de comptes coach, séparés par des virgules): confirment les inscriptions des joueurs
ADMIN_EMAILS=
# Version bêta: tous les messages aux joueurs par e-mail (0 = moyen choisi par le joueur: WhatsApp, SMS ou e-mail)
NOTIFY_EMAIL_ONLY=1
# Comptes « test » des agents de test quotidiens (e-mails de connexion, coach et joueur, séparés par des virgules):
# invisibles des vrais utilisateurs (voir DEPLOY.md). Vide = aucun compte test.
TEST_ACCOUNT_EMAILS=
